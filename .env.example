# Digital Shop - Environment Variables Template
# Copy this file to .env and fill in your values

# Django Core
DEBUG=True
SECRET_KEY=your-secret-key-generate-with-django-secret-key-generator
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (SQLite for dev, PostgreSQL for production)
USE_POSTGRES=False
POSTGRES_DB=digital_shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60

# Redis (for caching, sessions, Celery)
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_ALGORITHM=HS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_LIFETIME_MINUTES=30
JWT_REFRESH_LIFETIME_DAYS=7
JWT_AUDIENCE=digital-shop-api
JWT_ISSUER=digital-shop
JWT_JWK_URL=
JWT_LEEWAY=10
JWT_SLIDING_LIFETIME_MINUTES=30
JWT_SLIDING_REFRESH_DAYS=7

# Password Security
PBKDF2_ITERATIONS=720000

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Digital Shop <noreply@digitalshop.ir>

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security (Production)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Celery (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional: Two-factor authentication
# TWO_FACTOR_AUTH=False

# Optional: Django Axes for brute-force protection
AXES_ENABLED=False

# Cache
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=unique-snowflake
SESSION_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache